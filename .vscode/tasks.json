{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Python Requirements (Inchscape Repo)",
      "type": "shell",
      "command": "c:/Users/14bcr/OneDrive/Documents/GitHub/Lumpy_Fellas-/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "pip",
        "install",
        "-r",
        "requirements.txt"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Inchscape Repo"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Start SKU Forecast App (No Install)",
      "type": "shell",
      "command": "c:/Users/14bcr/OneDrive/Documents/GitHub/Lumpy_Fellas-/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.backend.server:app",
        "--reload"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Inchscape Repo"
      },
      "isBackground": true,
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Run SKU Forecast App",
      "dependsOn": [
        "Install Python Requirements (Inchscape Repo)",
        "Start SKU Forecast App (No Install)"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
